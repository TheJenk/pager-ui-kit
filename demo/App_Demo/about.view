VStack(spacing: 6) {
  Header("ABOUT")
  HStack {
    Text("STOPWATCH \(sw)", .amber, .small)
    Spacer()
    Text("BATT \(batt)%", .\(bcol), .small)
  }.h(14)
  Spacer()
